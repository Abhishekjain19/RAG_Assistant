# Required for Gemini summarisation, analysis, and RAG chat
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-3.5-flash-lite

# Local Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=small

# Optional: used when language is set to hinglish (Sarvam STT-translate)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# Optional / legacy
# MISTRAL_API_KEY=
